{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://whip4-you-be.vercel.app/api/sitemap.xml"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://whip4-you-be.vercel.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
